# Basis-URL des Deployments. GitHub Pages Projektseite: /<repo>/ ; eigene Domain: /
VITE_BASE_URL=/
# Pflichtangaben für die Veröffentlichung (Zeilenumbruch in der Adresse als \n)
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_CONTACT_EMAIL=
# Optional: Rechtsform, Register, Registernummer, USt-IdNr. – nur falls vorhanden
VITE_LEGAL_EXTRA=
VITE_HOSTING_PROVIDER=GitHub, Inc.
VITE_HOSTING_PRIVACY_URL=https://docs.github.com/de/site-policy/privacy-policies/github-general-privacy-statement
VITE_REPO_URL=
# Phase 2 (Supabase). Leer lassen, solange nur der lokale Adapter genutzt wird.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_REGION=
VITE_SUPABASE_DPA_URL=
